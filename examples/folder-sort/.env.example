# コピーして .env にする。無い項目は、その機能を飛ばす
SOURCE_DIR=                 # 空なら ~/Downloads
DEST_DIR=                   # 空なら SOURCE_DIR/整理済み
MIN_AGE_MINUTES=10          # これより新しいファイルは触らない(ダウンロード中かもしれない)

JEV_API_KEY=                # 判定AI。無ければ文書は「その他」扱い
MIN_PROBABILITY=0.6         # これ未満の確からしさは「要確認」フォルダへ

DISCORD_WEBHOOK=            # 完了通知の送り先(サーバー設定 → 連携サービス → ウェブフック)
DISCORD_USER_ID=            # 失敗時にメンションする自分の ID(開発者モードで右クリック → IDをコピー)

GAS_URL=                    # 生存報告の受け口(GAS をウェブアプリとして公開した URL)
